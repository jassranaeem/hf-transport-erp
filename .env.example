# =============================================================================
#  HF Transport ERP - environment configuration
# =============================================================================
#  Copy this file to `.env.local` and fill in real values, then `npm run dev`.
#  Google AI Studio injects these automatically; every other environment
#  (local, Docker, VPS, Cloud Run, CI) needs this file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# --- Local dev login bypass (NEVER set in production) -----------------------
# When true AND NODE_ENV != "production", the login screen shows a
# "Developer login" button that authenticates without Firebase - useful before
# you have a service-account key. Refused automatically when NODE_ENV=production.
DEV_AUTH_BYPASS="false"
DEV_AUTH_EMAIL="you@example.com"

# Vite HMR rides the main server port; set "true" only to disable hot reload.
DISABLE_HMR="false"

# --- Database (PostgreSQL) --------------------------------------------------
# Option A (preferred): one connection string.
# The docker-compose `db` service maps to this by default:
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/hf_transport_erp?sslmode=disable"
# Set to "true" for managed Postgres that requires TLS (Neon, Supabase, RDS...)
DATABASE_SSL="false"

# Option B: discrete vars (used by AI Studio). Only needed if DATABASE_URL unset.
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_LOCAL_PASSWORD"
SQL_DB_NAME="hf_transport_erp"
# Used by drizzle-kit migrations only (npm run db:*):
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="YOUR_LOCAL_PASSWORD"

# --- Cache / queues (optional) --------------------------------------------
# If unset the app uses an in-memory fallback - fine for local dev.
REDIS_URL="redis://localhost:6379"

# --- Authentication (native - no Firebase) --------------------------------
# REQUIRED. Sign session JWTs with this. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_TTL_SECONDS="604800"          # 7 days

# The account that is always Super Admin (create it with the password below, or
# just sign in with this Google account).
SUPER_ADMIN_EMAIL="jassranaeem@gmail.com"
# Optional: password for the seeded super-admin. If blank, a random one is
# printed to the server console on first boot.
SUPER_ADMIN_PASSWORD=""

# "Sign in with Google" (optional). Create an OAuth 2.0 Client ID (type: Web) at
# https://console.cloud.google.com/apis/credentials - add your origin
# (http://localhost:3000 and your prod URL) to "Authorized JavaScript origins".
# Only the client ID is needed (it is public); no client secret.
GOOGLE_CLIENT_ID=""

# --- Gemini AI -----------------------------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Google Maps (live GPS / fleet tracking map) ------------------------
# Browser key, restricted to your domains. Enable "Maps JavaScript API" +
# "Geocoding API" in Google Cloud console, and enable billing.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_BROWSER_KEY"
